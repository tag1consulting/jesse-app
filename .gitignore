# macOS
.DS_Store
# Xcode
build/
DerivedData/
*.xcuserstate
**/xcuserdata/
# Swift Package Manager (JesseKit local package build products + user config)
.build/
.swiftpm/

# Rust
target/
# local agent settings (never commit; may hold machine-local config)
.claude/
.codex/
# internal worklog — never shipped (R5: no personal infra in tracked files)
STATUS.md

# APNs auth keys — never commit (belt-and-suspenders; keys live outside the tree)
*.p8

# cruft
_removed-python/
*.fuse_hidden*

# Local personalization overlay — never commit (holds the owner's real name,
# languages, vocabulary). Ship jesse.example.toml; copy it to jesse.local.toml
# and edit that. See README → "Make Jesse yours".
jesse.local.toml

# Local CI-guard denylist — the owner's real name/hostnames/IPs the R5 guard
# should catch locally. Ship scripts/ci-guards.local.sh.example; copy it. Org CI
# won't have this file, which is expected.
scripts/ci-guards.local.sh

# Local eval suites pinned to a real vault (real facts, filenames). The shipped
# vaultqa-example.json is the generic template; real suites live here, gitignored.
eval/suites/local/
todo-list/

# Eval run artifacts under eval-runs/. THE SPLIT IS DELIBERATE, not a size
# optimisation: `results.json`, `scorecard.md`, `judgment.md` and `compare.md`
# are the RECORD a gate report cites and they are tracked; `transcripts/` and
# `answers/` are bulk model output that nothing cites line-by-line, so they stay
# out of git and out of every diff.
eval-runs/*/transcripts/
eval-runs/*/answers/

# A run of a suite with `workspace = "vault-readonly"` tasks reads the owner's
# real vault, and its `results.json` carries `final_answer` — i.e. VAULT CONTENT.
# Those runs are therefore ignored WHOLE, not merely trimmed: only their
# aggregate numbers (pass rate, latency, tool calls) may be quoted, in a report.
# The fixture-only suites (product-v1, diet-v1) touch no vault and stay tracked.
eval-runs/*vaultqa*/
eval-runs/*jesse-v1*/
